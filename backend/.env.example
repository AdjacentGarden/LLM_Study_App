# BookCourse AI Backend - example environment variables
# Copy to `.env` and override as needed. The backend reads variables from the
# process environment, not from this file. The defaults below match the code
# at commit time.

# ---- Security / authentication ----
BOOKCOURSE_ENVIRONMENT=development
# Local development profile. Production operators must start from the
# fail-closed `../deploy/bookcourse.production.env.example` instead.
BOOKCOURSE_DOCS_ENABLED=true
# `strict` (default) requires BOOKCOURSE_API_KEY for all business routes.
# `optional` runs the demo with no API key (useful for debugging on the judge
# machine). When `strict`, requests must also send `X-BookCourse-User-Id`
# matching the path user_id; otherwise 403 forbidden_user_mismatch.
BOOKCOURSE_AUTH_MODE=strict
BOOKCOURSE_API_KEY=
# Secret shared only between the reverse proxy and backend. In production the
# proxy must strip client-supplied identity headers, authenticate the session,
# then inject this token plus the verified X-BookCourse-User-Id.
BOOKCOURSE_TRUSTED_PROXY_TOKEN=
# Optional admin token for privileged maintenance routes.
BOOKCOURSE_ADMIN_TOKEN=
# Default user used when no `X-BookCourse-User-Id` is supplied in `optional`
# mode (so existing demos still work out of the box).
BOOKCOURSE_DEFAULT_USER_ID=local_user

# ---- Storage / persistence ----
BOOKCOURSE_STORAGE_ROOT=./storage
# When `true`, jobs / submissions / plans / mistakes / lessons / images are
# mirrored to `BOOKCOURSE_STORAGE_ROOT/_state/*.json` so a restart survives.
BOOKCOURSE_PERSIST_STATE=true

# ---- Upload and OOXML safety limits ----
BOOKCOURSE_MAX_UPLOAD_BYTES=104857600
BOOKCOURSE_MAX_PDF_PAGES=500
BOOKCOURSE_COMMUNITY_DOWNLOAD_TIMEOUT_SECONDS=45
BOOKCOURSE_MAX_PDF_RENDER_PIXELS=40000000
BOOKCOURSE_MAX_IMAGE_PIXELS=40000000
BOOKCOURSE_MAX_ZIP_ENTRIES=10000
BOOKCOURSE_MAX_ZIP_ENTRY_UNCOMPRESSED_BYTES=67108864
BOOKCOURSE_MAX_ZIP_TOTAL_UNCOMPRESSED_BYTES=536870912
BOOKCOURSE_MAX_ZIP_COMPRESSION_RATIO=100
BOOKCOURSE_MAX_OFFICE_XML_BYTES=16777216
BOOKCOURSE_MAX_OOXML_RELATIONSHIPS=10000
BOOKCOURSE_MAX_PPTX_SLIDES=500
BOOKCOURSE_MAX_XLSX_SHEETS=256
BOOKCOURSE_MAX_DOCX_RESOURCES=2000
BOOKCOURSE_OFFICE_VALIDATION_TIMEOUT_SECONDS=15

# ---- Rate limiting ----
BOOKCOURSE_GLOBAL_RATE_PER_MINUTE=120
BOOKCOURSE_WRITE_RATE_PER_MINUTE=30
BOOKCOURSE_RATE_LIMIT_MAX_BUCKETS=10000
BOOKCOURSE_RATE_LIMIT_BUCKET_TTL_SECONDS=600

# ---- Background task queue ----
# `true` runs heavy tasks on a daemon thread; `false` is useful only for local
# deterministic debugging and the automated test profile.
BOOKCOURSE_USE_WORKER=false

# ---- RAG cache (Stage 2 retrieval) ----
BOOKCOURSE_RAG_CACHE_ENABLED=true
BOOKCOURSE_RAG_CACHE_MAX_BOOKS=8
BOOKCOURSE_RAG_CACHE_TTL_SECONDS=600
# Cache complete grounded answers as well as retrieval indexes. Identical
# concurrent questions share one in-flight computation to avoid LLM stampedes.
BOOKCOURSE_RAG_ANSWER_CACHE_MAX_ITEMS=256

# ---- Document parsing ----
# Stage 2 uses the local CUDA MinerU service as the primary parser.
# `auto` currently follows the same MinerU-first route. Explicit `pymupdf`,
# `ocr`, and `marker` values are intended for rollback/diagnosis.
BOOKCOURSE_PARSER_PROVIDER=mineru
BOOKCOURSE_LAYOUT_PROVIDER=opencv
# Optional Marker command/endpoint used by the legacy external adapter.
BOOKCOURSE_MARKER_COMMAND=
BOOKCOURSE_MARKER_ENDPOINT=
# MinerU HTTP endpoint. It is restricted to an explicit loopback origin and
# should point at the CUDA service installed on this host.
BOOKCOURSE_MINERU_ENDPOINT=http://127.0.0.1:8001
BOOKCOURSE_MINERU_BACKEND=hybrid
BOOKCOURSE_MINERU_EFFORT=high
BOOKCOURSE_MINERU_PARSE_METHOD=auto
BOOKCOURSE_MINERU_LANGUAGE=ch
BOOKCOURSE_MINERU_TIMEOUT_SECONDS=900
BOOKCOURSE_MINERU_CONNECT_TIMEOUT_SECONDS=10
BOOKCOURSE_MINERU_REQUEST_TIMEOUT_SECONDS=60
BOOKCOURSE_MINERU_POLL_INTERVAL_SECONDS=2
# Applies only to safe GET operations and explicit POST 429 rejections.
# Ambiguous POST transport/5xx failures are never replayed.
BOOKCOURSE_MINERU_MAX_RETRIES=2
BOOKCOURSE_MINERU_RETRY_BACKOFF_SECONDS=0.5
BOOKCOURSE_MINERU_RETRY_MAX_BACKOFF_SECONDS=10
# Upper bound for the decoded JSON result, including base64 images (256 MiB).
BOOKCOURSE_MINERU_MAX_RESULT_BYTES=268435456
BOOKCOURSE_MINERU_FORMULA_ENABLE=true
BOOKCOURSE_MINERU_TABLE_ENABLE=true
BOOKCOURSE_MINERU_IMAGE_ANALYSIS=true
BOOKCOURSE_MINERU_RETURN_IMAGES=true

# ---- OCR ----
# PaddleOCR-VL 1.6 is the high-accuracy fail-closed OCR fallback. If its dependency/model is
# unavailable or recognition fails, the parse attempt is reported unavailable;
# it never silently switches to Mock OCR. `mock` is for tests only, emits
# `ocr_pending`, fails the quality gate, and is excluded from RAG chunks.
BOOKCOURSE_OCR_PROVIDER=paddleocr-vl
BOOKCOURSE_OCR_MODEL=PaddleOCR-VL-1.6
BOOKCOURSE_OCR_VL_PIPELINE_VERSION=v1.6
BOOKCOURSE_OCR_LANGUAGE=ch
# Keep PaddleOCR on CPU while MinerU owns the CUDA GPU unless a compatible
# Paddle GPU runtime has been installed and verified separately.
BOOKCOURSE_OCR_DEVICE=cpu
# Optional production acceleration. Leave blank for fully local inference, or
# point the complete PaddleOCR-VL pipeline at a compatible inference service.
BOOKCOURSE_OCR_VL_BACKEND=
BOOKCOURSE_OCR_VL_SERVER_URL=
BOOKCOURSE_OCR_VL_API_KEY=
BOOKCOURSE_OCR_VL_MAX_CONCURRENCY=4
# `false` is the verified Windows-safe default.
BOOKCOURSE_OCR_ENABLE_MKLDNN=false
# Keep Paddle's model and inference in one persistent child process. This is
# required on Windows to keep parse progress/generation checks responsive while
# native Paddle code is running.
BOOKCOURSE_OCR_PROCESS_ISOLATION=true
BOOKCOURSE_OCR_WORKER_STARTUP_TIMEOUT_SECONDS=120
BOOKCOURSE_OCR_RECOGNITION_TIMEOUT_SECONDS=300
# `fast` lowers render cost, `balanced` is the production default, and
# `quality` renders more pixels and retries low-confidence pages.
BOOKCOURSE_OCR_QUALITY_PROFILE=balanced
# Optional explicit override; blank uses the profile default (1.5 / 2.0 / 2.5).
BOOKCOURSE_OCR_RENDER_ZOOM=
BOOKCOURSE_OCR_ADAPTIVE_RETRY=true
# Let PP-OCRv6 recover tiny/sparse text when the VL layout pass is weak.
BOOKCOURSE_OCR_TEXT_FALLBACK_ENABLED=true
BOOKCOURSE_OCR_RETRY_MIN_SEMANTIC_CHARS=20
# Content-addressed results avoid re-running the model for unchanged pages.
BOOKCOURSE_OCR_CACHE_ENABLED=true
BOOKCOURSE_OCR_CACHE_TTL_SECONDS=604800
BOOKCOURSE_OCR_CACHE_MAX_ITEMS=2000
BOOKCOURSE_OCR_LOW_CONFIDENCE_THRESHOLD=0.55
BOOKCOURSE_OCR_TEXT_CONFIDENCE_THRESHOLD=0.5

# ---- Image preprocessing thresholds ----
BOOKCOURSE_IMAGE_DARK_THRESHOLD=55
BOOKCOURSE_IMAGE_BRIGHT_THRESHOLD=235
BOOKCOURSE_IMAGE_BLUR_THRESHOLD=35
BOOKCOURSE_IMAGE_DARK_BORDER_RATIO=0.18
BOOKCOURSE_PREPROCESS_MEDIAN_KERNEL=3
BOOKCOURSE_PREPROCESS_ADAPTIVE_BLOCK_SIZE=35
BOOKCOURSE_PREPROCESS_ADAPTIVE_C=11

# ---- Chunker V2 ----
# Token counts use the non-configurable BAAI/bge-m3 tokenizer revision and
# exact transformers/tokenizers package versions documented in the README.
BOOKCOURSE_CHUNK_TARGET_TOKENS=450
BOOKCOURSE_CHUNK_MAX_TOKENS=700
BOOKCOURSE_CHUNK_MIN_TOKENS=120
BOOKCOURSE_CHUNK_OVERLAP_TOKENS=80
BOOKCOURSE_CHUNK_ATOMIC_CONTENT_HARD_MAX_TOKENS=900
BOOKCOURSE_CHUNK_QUALITY_THRESHOLD=0.45
BOOKCOURSE_CHUNK_VERSION=v2

# ---- AI image generation ----
# `mock` (default) is fine for verification; set to `openai_compatible` when
# you plug in a real image backend.
BOOKCOURSE_IMAGE_PROVIDER=mock
BOOKCOURSE_IMAGE_API_URL=
BOOKCOURSE_IMAGE_API_KEY=
BOOKCOURSE_IMAGE_PROVIDER_MAX_RESPONSE_BYTES=20971520

# ---- Embedding / retrieval ----
# BGE-M3 uses the frozen revision below. On the verified local RTX setup set
# BOOKCOURSE_EMBEDDING_PROVIDER=bge_m3 and BOOKCOURSE_EMBEDDING_DEVICE=cuda:0.
# pgvector V2 always requires 1024 dimensions. Application requests never run
# database migrations automatically; BOOKCOURSE_DATABASE_URL must point to a
# separately approved and migrated database.
BOOKCOURSE_EMBEDDING_PROVIDER=hashing
BOOKCOURSE_BGE_M3_MODEL=BAAI/bge-m3
BOOKCOURSE_BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
BOOKCOURSE_EMBEDDING_VERSION=v1
BOOKCOURSE_EMBEDDING_DEVICE=auto
BOOKCOURSE_EMBEDDING_BATCH_SIZE=16
BOOKCOURSE_EMBEDDING_DIMENSIONS=1024
BOOKCOURSE_RAG_INDEX_PROVIDER=pgvector
BOOKCOURSE_DATABASE_URL=
BOOKCOURSE_VECTOR_TOP_K=80
BOOKCOURSE_BM25_TOP_K=80
BOOKCOURSE_RERANK_INPUT_K=30
BOOKCOURSE_FINAL_CONTEXT_K=5
BOOKCOURSE_RERANKER_PROVIDER=heuristic
BOOKCOURSE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# `true` keeps answers available with a logged heuristic fallback; set false
# when model-backed reranking is a hard production requirement.
BOOKCOURSE_RERANKER_FAIL_OPEN=true

# ---- Lesson / RAG answer LLM ----
# `template` (default) keeps the demo dependency-free and deterministic.
BOOKCOURSE_RAG_LLM_PROVIDER=template
BOOKCOURSE_LLM_PROVIDER=template
BOOKCOURSE_LLM_API_URL=
BOOKCOURSE_LLM_API_KEY=
BOOKCOURSE_LLM_MODEL=gpt-4.1-mini
# Optional per-workload overrides for any OpenAI-compatible provider.
BOOKCOURSE_LESSON_LLM_MODEL=
BOOKCOURSE_RAG_LLM_MODEL=
BOOKCOURSE_LLM_TIMEOUT_SECONDS=60
# Hard prompt/output budgets prevent a long textbook chapter from creating an
# unbounded request or unexpectedly large bill.
BOOKCOURSE_LLM_MAX_INPUT_CHARS=120000
BOOKCOURSE_LLM_MAX_OUTPUT_TOKENS=4096
# Shared production controls for both lesson generation and RAG answers.
# Explicit 408/409/425/429/5xx responses are retried with jitter. Ambiguous
# POST transport failures are not replayed unless explicitly enabled.
BOOKCOURSE_AI_MAX_CONCURRENT=4
BOOKCOURSE_AI_QUEUE_TIMEOUT_SECONDS=5
BOOKCOURSE_AI_MAX_RETRIES=2
BOOKCOURSE_AI_RETRY_BACKOFF_SECONDS=0.5
BOOKCOURSE_AI_RETRY_MAX_BACKOFF_SECONDS=8
BOOKCOURSE_AI_RETRY_TRANSPORT_ERRORS=false
BOOKCOURSE_AI_CIRCUIT_FAILURE_THRESHOLD=5
BOOKCOURSE_AI_CIRCUIT_RESET_SECONDS=30
BOOKCOURSE_AI_MAX_RESPONSE_BYTES=2097152
BOOKCOURSE_AI_CACHE_ENABLED=true
BOOKCOURSE_AI_CACHE_TTL_SECONDS=300
BOOKCOURSE_AI_CACHE_MAX_ITEMS=256

# ---- DeepSeek (optional, when BOOKCOURSE_*_LLM_PROVIDER=deepseek) ----
BOOKCOURSE_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
BOOKCOURSE_DEEPSEEK_API_KEY=
BOOKCOURSE_DEEPSEEK_MODEL=deepseek-v4-flash
# Use the stronger Pro model for asynchronous lesson authoring and Flash for
# latency-sensitive textbook Q&A. Either can be overridden independently.
BOOKCOURSE_DEEPSEEK_LESSON_MODEL=deepseek-v4-pro
BOOKCOURSE_DEEPSEEK_RAG_MODEL=deepseek-v4-flash
BOOKCOURSE_DEEPSEEK_THINKING=disabled
