APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8100
APP_DATA_DIR=./data
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 邮箱注册/登录：真实邮箱始终需要安全 SMTP；不会回传验证码。
AUTH_DEMO_MODE=0
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# 文档重建
DOCUMENT_PRIMARY_EXTRACTOR=mineru
MINERU_COMMAND=mineru
DOCUMENT_RENDER_DPI=300
DOCUMENT_OCR_RETRY_DPI=420
DOCUMENT_QUALITY_ACCEPT=0.90
DOCUMENT_QUALITY_REVIEW=0.72
DOCUMENT_VISION_RESCUE_ENABLED=true
OCR_WORKER_ENABLED=false
OCR_WORKER_LEASE_SECONDS=90
OCR_WORKER_POLL_SECONDS=1
OCR_RETRY_DELAY_SECONDS=30
OCR_MAX_ATTEMPTS=3
OCR_BACKEND=vlm-auto-engine
MINERU_MODEL_SOURCE=local
MINERU_TOOLS_CONFIG_JSON=/data1/zhenghang/adaptive-book-ocr/config/mineru.json

# LLM：密钥只能配置在 .env 或部署平台 Secret 中
LLM_PROVIDER=pucoding
LLM_HTTPS_PROXY=
PUCODING_BASE_URL=https://pucoding.com/v1
PUCODING_API_KEY=
PUCODING_TEXT_MODEL=gpt-5.6-terra
PUCODING_VISION_MODEL=gpt-5.6-terra
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 理解工作台：规划、笔迹识别与整理均使用已通过真实链路验证的 PUCODING
STUDIO_LLM_PROVIDER=pucoding
STUDIO_NOTE_LLM_PROVIDER=pucoding
STUDIO_LLM_MODEL=MiniMax-M3

# 语音笔记：离线转写，录音不会发送给外部语音服务
VOICE_ASR_PYTHON=/usr/bin/python3
VOICE_ASR_PYTHONPATH=/data1/zhenghang/adaptive-book-ocr/studio-runtime/asr-lib
VOICE_ASR_MODEL=/data1/zhenghang/adaptive-book-ocr/models/faster-whisper-small
VOICE_ASR_SCRIPT=/data1/zhenghang/adaptive-book-ocr/app/deployment/server/transcribe_voice_note.py

# 持久化 RAG（目录必须包含 index_manifest.json、chunks.json、embeddings.npy）
RAG_BOOK_ID=biology-required-2
RAG_INDEX_DIR=/data1/zhenghang/adaptive-book-ocr/rag-eval/index
RAG_EMBEDDING_MODEL_PATH=/data1/zhenghang/adaptive-book-ocr/rag-eval/models/bge-small-zh-v1.5
RAG_RERANKER_MODEL_PATH=/data1/zhenghang/adaptive-book-ocr/rag-eval/models/bge-reranker-base
RAG_DEVICE=auto
RAG_REFUSAL_SCORE_THRESHOLD=0
RAG_TOP_PAGES=5
RAG_MAX_EVIDENCE=10

# 主动诊断
ASSESSMENT_MIN_ITEMS=5
ASSESSMENT_MAX_ITEMS=12
ASSESSMENT_STOP_UNCERTAINTY=0.035
ASSESSMENT_OPEN_ANSWER_MIN_CONFIDENCE=0.78
