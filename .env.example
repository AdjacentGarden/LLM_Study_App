APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8100
APP_DATA_DIR=./data
# Optional authoritative PostgreSQL. Empty URL/host keeps local SQLite.
DATABASE_URL=
DATABASE_POOL_SIZE=8
# Compose uses host/name/user/password fields to preserve special password characters.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=adaptive_learning
DATABASE_USER=adaptive_learning
DATABASE_PASSWORD=
# Optional shared 32-byte hex key for API replicas; otherwise preserve state/account-otp.key.
ACCOUNT_SIGNING_KEY=
STUDIO_WORKER_ENABLED=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 邮箱注册/登录：真实邮箱始终需要安全 SMTP；不会回传验证码。
AUTH_DEMO_MODE=0
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# 文档重建
DOCUMENT_PRIMARY_EXTRACTOR=mineru
MINERU_COMMAND=mineru
DOCUMENT_RENDER_DPI=300
DOCUMENT_OCR_RETRY_DPI=420
DOCUMENT_QUALITY_ACCEPT=0.90
DOCUMENT_QUALITY_REVIEW=0.72
DOCUMENT_VISION_RESCUE_ENABLED=true
OCR_WORKER_ENABLED=false
OCR_WORKER_LEASE_SECONDS=90
OCR_WORKER_POLL_SECONDS=1
OCR_RETRY_DELAY_SECONDS=30
OCR_MAX_ATTEMPTS=3
OCR_BACKEND=vlm-auto-engine
# OCR heuristic scoring is a different model from DOCUMENT_QUALITY_* above.
OCR_PAGE_QUALITY_ACCEPT=0.82
OCR_PAGE_QUALITY_REVIEW=0.66
OCR_PAGE_STRUCTURED_REVIEW=0.50
MINERU_MODEL_SOURCE=local
MINERU_TOOLS_CONFIG_JSON=/data1/zhenghang/adaptive-book-ocr/config/mineru.json
# Optional resident MinerU API on this machine, for example http://127.0.0.1:18200.
# Only loopback HTTP URLs are accepted. Leave empty to launch a temporary API per job.
MINERU_API_URL=
# Resident mode applies engine options when starting the service, not in this client.
MINERU_ENGINE_ARGS_JSON=[]
ORT_DISABLE_TELEMETRY=1

# LLM：密钥只能配置在 .env 或部署平台 Secret 中
LLM_PROVIDER=pucoding
LLM_HTTPS_PROXY=
# 留空时模型请求直连；需要代理时显式填写，不继承终端 HTTP_PROXY/HTTPS_PROXY。
PUCODING_BASE_URL=https://pucoding.com/v1
PUCODING_API_KEY=
PUCODING_TEXT_MODEL=gpt-5.6-terra
PUCODING_VISION_MODEL=gpt-5.6-terra
# 生图使用 PUCODING OpenAI Images 接口，密钥需绑定支持图片的 Codex 分组。
PUCODING_IMAGE_MODEL=gpt-image-2
PUCODING_IMAGE_SIZE=1024x768
PUCODING_IMAGE_QUALITY=auto
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_VIDEO_MODEL=MiniMax-H3-Max
# 生视频为 6 秒 / 768P，使用 H3 V2 接口；审核需要 FFmpeg 可执行文件。
STUDIO_FFMPEG=
# Windows 关系图字体示例：C:/Windows/Fonts/msyh.ttc
STUDIO_CJK_FONT=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 官方 DeepSeek 结构化调用开启思考，reasoning_effort=low；思考与最终 JSON 共用输出额度。

# 理解工作台：规划、笔迹识别与整理均使用已通过真实链路验证的 PUCODING
STUDIO_LLM_PROVIDER=pucoding
STUDIO_NOTE_LLM_PROVIDER=pucoding
STUDIO_LLM_MODEL=MiniMax-M3

# 语音笔记：离线转写，录音不会发送给外部语音服务
VOICE_ASR_PYTHON=/usr/bin/python3
VOICE_ASR_PYTHONPATH=/data1/zhenghang/adaptive-book-ocr/studio-runtime/asr-lib
VOICE_ASR_MODEL=/data1/zhenghang/adaptive-book-ocr/models/faster-whisper-small
VOICE_ASR_SCRIPT=/data1/zhenghang/adaptive-book-ocr/app/deployment/server/transcribe_voice_note.py
VOICE_ASR_DEVICE=cpu
VOICE_ASR_COMPUTE_TYPE=int8

# 持久化 RAG（目录必须包含 index_manifest.json、chunks.json、embeddings.npy）
RAG_BOOK_ID=biology-required-2
RAG_INDEX_DIR=/data1/zhenghang/adaptive-book-ocr/rag-eval/index
RAG_EMBEDDING_MODEL_PATH=/data1/zhenghang/adaptive-book-ocr/rag-eval/models/bge-small-zh-v1.5
RAG_RERANKER_MODEL_PATH=/data1/zhenghang/adaptive-book-ocr/rag-eval/models/bge-reranker-base
RAG_DEVICE=auto
RAG_REFUSAL_SCORE_THRESHOLD=0
RAG_TOP_PAGES=5
RAG_MAX_EVIDENCE=10
RAG_MAX_OUTPUT_TOKENS=10000
RAG_GENERATION_TIMEOUT_SECONDS=120
RAG_RETRIEVAL_BUDGET_MS=2500
# The planner is redundant for most questions and adds a full model round trip.
RAG_USE_EVIDENCE_PLANNER=false
RAG_USE_SEMANTIC_REVIEW=true

# 主动诊断
ASSESSMENT_MIN_ITEMS=5
ASSESSMENT_MAX_ITEMS=12
ASSESSMENT_STOP_UNCERTAINTY=0.035
ASSESSMENT_OPEN_ANSWER_MIN_CONFIDENCE=0.78
