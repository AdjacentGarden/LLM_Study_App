APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8100
BACKEND_STARTUP_TIMEOUT_SECONDS=300
APP_DATA_DIR=./data
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 邮箱注册/登录：真实邮箱始终需要安全 SMTP；不会回传验证码。
AUTH_DEMO_MODE=0
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# 文档重建
DOCUMENT_PRIMARY_EXTRACTOR=mineru
MINERU_COMMAND=mineru
DOCUMENT_RENDER_DPI=300
DOCUMENT_OCR_RETRY_DPI=420
DOCUMENT_QUALITY_ACCEPT=0.90
DOCUMENT_QUALITY_REVIEW=0.72
DOCUMENT_VISION_RESCUE_ENABLED=true
OCR_WORKER_ENABLED=false
OCR_WORKER_LEASE_SECONDS=90
OCR_WORKER_POLL_SECONDS=1
OCR_RETRY_DELAY_SECONDS=30
OCR_MAX_ATTEMPTS=3
OCR_BACKEND=vlm-auto-engine
MINERU_MODEL_SOURCE=local
MINERU_TOOLS_CONFIG_JSON=
# 可选：复用常驻 MinerU；默认不启动 GPU 常驻服务。
MINERU_API_URL=
MINERU_RESIDENT_ENABLED=false
# OCR_RESIDENT_PORT=18200
MINERU_ENGINE_ARGS_JSON=[]
# 快速文本模式须显式设 OCR_BACKEND=paddle-gpu；具备 CUDA 的独立 OCR 环境。
FAST_OCR_API_URL=
# FAST_OCR_PORT=18201
FAST_OCR_MANAGED=true
# 可选：os.pathsep 分隔的绝对目录；空值请删除该行，以使用 runtime 默认目录。
# FAST_OCR_SOURCE_ROOTS=/path/to/input:/path/to/data
# FAST_OCR_OUTPUT_ROOTS=/path/to/data
# APP_PYTHON=/path/to/app-environment/bin/python
# OCR_PYTHON=/path/to/ocr-environment/bin/python
FORWARDED_ALLOW_IPS=127.0.0.1

# LLM：密钥只能配置在 .env 或部署平台 Secret 中
LLM_PROVIDER=pucoding
LLM_HTTPS_PROXY=
PUCODING_BASE_URL=https://pucoding.com/v1
PUCODING_API_KEY=
PUCODING_TEXT_MODEL=gpt-5.6-terra
PUCODING_VISION_MODEL=gpt-5.6-terra
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 共享章节线程池：1..8，默认 6；适配服务商并发限额。
BOOK_LLM_CONCURRENCY=6
# 空值表示使用服务商默认；false 显式关闭支持模型的思考。
TEXT_LLM_THINKING_ENABLED=
TEXT_LLM_REASONING_EFFORT=

# 理解工作台：规划、笔迹识别与整理均使用已通过真实链路验证的 PUCODING
STUDIO_LLM_PROVIDER=pucoding
STUDIO_NOTE_LLM_PROVIDER=pucoding
STUDIO_LLM_MODEL=MiniMax-M3

# 语音笔记：离线转写，录音不会发送给外部语音服务
VOICE_ASR_PYTHON=python3
VOICE_ASR_PYTHONPATH=
VOICE_ASR_MODEL=
VOICE_ASR_SCRIPT=

# 持久化 RAG（目录必须包含 index_manifest.json、chunks.json、embeddings.npy）
RAG_BOOK_ID=biology-required-2
RAG_INDEX_DIR=
RAG_EMBEDDING_MODEL_PATH=
RAG_RERANKER_MODEL_PATH=
RAG_DEVICE=auto
RAG_REFUSAL_SCORE_THRESHOLD=0
RAG_TOP_PAGES=5
RAG_MAX_EVIDENCE=10
RAG_RETRIEVAL_BUDGET_MS=2500
# The planner is redundant for most questions and adds a full model round trip.
RAG_USE_EVIDENCE_PLANNER=false
RAG_USE_SEMANTIC_REVIEW=true

# 主动诊断
ASSESSMENT_MIN_ITEMS=5
ASSESSMENT_MAX_ITEMS=12
ASSESSMENT_STOP_UNCERTAINTY=0.035
ASSESSMENT_OPEN_ANSWER_MIN_CONFIDENCE=0.78
# 允许收窄为原文支持的答案；仍必须通过语义审题，默认保留既有答案。
DIAGNOSTIC_ALLOW_GROUNDED_ANSWER_REWRITE=false
