[Unit]
Description=CloudPath Germany public HTTPS API
After=network-online.target cloudpath-germany4090-forward.service
Wants=network-online.target cloudpath-germany4090-forward.service

[Service]
Type=exec
WorkingDirectory=/root/cloudpath-ops/germany4090-public
Environment=CLOUDPATH_PUBLIC_API_UPSTREAM=http://127.0.0.1:18426
ExecStart=/root/cloudpath-ops/germany4090-public/.venv/bin/python /root/cloudpath-ops/germany4090-public/serve_https.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
