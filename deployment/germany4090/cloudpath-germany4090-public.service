[Unit]
Description=CloudPath Germany public HTTPS API
After=network-online.target cloudpath-germany4090-forward.service
Wants=network-online.target cloudpath-germany4090-forward.service

[Service]
Type=exec
WorkingDirectory=/root/cloudpath-ops/germany4090-public
Environment=CLOUDPATH_PUBLIC_API_UPSTREAM=http://127.0.0.1:18426
ExecStart=/root/cloudpath-ops/germany4090-public/.venv/bin/python -m uvicorn public_api_proxy:app --host 0.0.0.0 --port 18443 --ssl-certfile /etc/letsencrypt/live/cloudpath-vps-ip/fullchain.pem --ssl-keyfile /etc/letsencrypt/live/cloudpath-vps-ip/privkey.pem
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
