# Copy to /etc/bookcourse/bookcourse.env, chmod 600, and replace every
# REQUIRED value before starting the service.
BOOKCOURSE_ENVIRONMENT=production
BOOKCOURSE_DOCS_ENABLED=false
BOOKCOURSE_AUTH_MODE=strict
BOOKCOURSE_API_KEY=REQUIRED_RANDOM_SECRET
BOOKCOURSE_TRUSTED_PROXY_TOKEN=REQUIRED_DIFFERENT_RANDOM_SECRET
BOOKCOURSE_ALLOWED_ORIGINS=https://bookcourse.example.com
BOOKCOURSE_STORAGE_ROOT=/var/lib/bookcourse
BOOKCOURSE_PERSIST_STATE=true
BOOKCOURSE_USE_WORKER=true
BOOKCOURSE_MAX_PDF_RENDER_PIXELS=40000000

BOOKCOURSE_PARSER_PROVIDER=mineru
BOOKCOURSE_MINERU_ENDPOINT=http://127.0.0.1:8001
BOOKCOURSE_EMBEDDING_PROVIDER=bge_m3
BOOKCOURSE_EMBEDDING_DEVICE=cuda:0
BOOKCOURSE_RERANKER_PROVIDER=bge
BOOKCOURSE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BOOKCOURSE_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
BOOKCOURSE_RERANKER_DEVICE=cuda:0
BOOKCOURSE_RERANKER_FAIL_OPEN=false
BOOKCOURSE_RAG_INDEX_PROVIDER=pgvector
BOOKCOURSE_DATABASE_URL=postgresql://REQUIRED_USER:REQUIRED_PASSWORD@127.0.0.1/bookcourse

BOOKCOURSE_LLM_PROVIDER=deepseek
BOOKCOURSE_RAG_LLM_PROVIDER=deepseek
BOOKCOURSE_DEEPSEEK_API_KEY=REQUIRED_PROVIDER_SECRET
BOOKCOURSE_IMAGE_PROVIDER=openai_compatible
BOOKCOURSE_IMAGE_API_URL=https://REQUIRED_IMAGE_PROVIDER/v1/images/generations
BOOKCOURSE_IMAGE_API_KEY=REQUIRED_PROVIDER_SECRET
BOOKCOURSE_IMAGE_PROVIDER_MAX_RESPONSE_BYTES=20971520

BOOKCOURSE_GLOBAL_RATE_PER_MINUTE=120
BOOKCOURSE_WRITE_RATE_PER_MINUTE=30
BOOKCOURSE_RATE_LIMIT_MAX_BUCKETS=10000
BOOKCOURSE_RATE_LIMIT_BUCKET_TTL_SECONDS=600
